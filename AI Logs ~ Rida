    public int transitRent(int owned) {
        if (owned <= 0) return 0;
        return 25 * (int) powerOfTwo(owned - 1);
    }

    // Helper recursive method for powers of 2 (zero loops)
    private int powerOfTwo(int exp) {
        if (exp == 0) return 1;
        return 2 * powerOfTwo(exp - 1);
    }
