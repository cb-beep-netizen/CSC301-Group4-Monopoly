2. CircularDoublyLinkedList Class
Java
package monopoly;

public class CircularDoublyLinkedList<T> {
    private Node<T> head = null;
    private int size = 0;

    public int size() {
        return size;
    }

    public Node<T> getHead() {
        return head;
    }

    public void addLast(T data) {
        Node<T> newNode = new Node<>(data);
        if (head == null) {
            head = newNode;
            head.next = head;
            head.prev = head;
        } else {
            Node<T> tail = head.prev;
            tail.next = newNode;
            newNode.prev = tail;
            newNode.next = head;
            head.prev = newNode;
        }
        size++;
    }

    public void insertAfter(Node<T> target, T data) {
        if (target == null) return;
        Node<T> newNode = new Node<>(data);
        Node<T> nextNode = target.next;

        target.next = newNode;
        newNode.prev = target;
        newNode.next = nextNode;
        nextNode.prev = newNode;
        size++;
    }

    public void remove(Node<T> target) {
        if (head == null || target == null) return;
        if (size == 1) {
            head = null;
        } else {
            target.prev.next = target.next;
            target.next.prev = target.prev;
            if (target == head) {
                head = target.next;
            }
        }
        size--;
    }
}
3. LinkedQueue Class
Java
package monopoly;

import java.util.NoSuchElementException;

public class LinkedQueue<T> {
    private static class QNode<T> {
        T data;
        QNode<T> next;
        QNode(T data) { this.data = data; }
    }

    private QNode<T> front = null;
    private QNode<T> rear = null;
    private int size = 0;

    public boolean isEmpty() {
        return front == null;
    }

    public int size() {
        return size;
    }

    public void enqueue(T item) {
        QNode<T> newNode = new QNode<>(item);
        if (isEmpty()) {
            front = newNode;
            rear = newNode;
        } else {
            rear.next = newNode;
            rear = newNode;
        }
        size++;
    }

    public T dequeue() {
        if (isEmpty()) {
            throw new NoSuchElementException("Queue is empty.");
        }
        T data = front.data;
        front = front.next;
        if (front == null) {
            rear = null;
        }
        size--;
        return data;
    }

    public T peek() {
        if (isEmpty()) {
            throw new NoSuchElementException("Queue is empty.");
        }
        return front.data;
    }
}
